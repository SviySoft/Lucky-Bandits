# LUCKY BANDITS — optional environment configuration
#
# The game runs fully self-contained by default: RNG, maths, wallet and history all live
# in the browser (demo/play-money mode). Set the two variables below to hand control to a
# real casino backend instead — the client then only renders what the server decides.
#
# Leave them empty (or delete this file) to keep the built-in demo mode.

# Base URL of your game server, without a trailing slash.
# Endpoints used: POST /game/session, POST /game/spin, POST /game/bonus,
#                 GET  /game/balance, GET  /game/history
VITE_GAME_API_URL=

# Player session token sent as: Authorization: Bearer <token>
VITE_GAME_API_TOKEN=
